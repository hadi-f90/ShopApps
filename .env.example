# ShopApps environment variables (copy to .env and fill in)
# .env is gitignored — never commit real secrets.

# Optional future API keys (Phase 2+)
# GROK_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Database path override (default: shopapps.db in working directory)
# SHOPAPPS_DB_PATH=shopapps.db
